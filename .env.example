# =============================================================================
# Congestion Watch 環境変数設定ファイル（テンプレート）
# =============================================================================
# このファイルをコピーして .env ファイルを作成し、必要な値を設定してください
# cp .env.example .env

# 開発環境設定
ENV=development
DEBUG=true

# データベース設定
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=congestion_watch
POSTGRES_USER=congestion_user
POSTGRES_PASSWORD=secure_password

# テスト用データベース
POSTGRES_TEST_DB=congestion_watch_test

# API設定
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# 機械学習設定
ML_MODEL_PATH=./models
ML_RETRAIN_INTERVAL=3600  # 1時間ごと
ML_PREDICTION_INTERVAL=300  # 5分ごと

# ログ設定
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# 監視設定
MONITORING_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# 秘匿情報 - 以下は必ず実際の値に変更してください
# =============================================================================

# Google Spreadsheet Configuration
SPREADSHEET_ID=your-spreadsheet-id
SPREADSHEET_GID=your-spreadsheet-gid

# OpenWeather API Configuration
OPENWEATHER_API_KEY=your-openweather-api-key
WEATHER_LOCATION=Tokyo,JP

# Google Maps Platform API Configuration  
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Weights & Biases設定（オプション）
# WANDB_PROJECT=congestion-watch
# WANDB_ENTITY=your-wandb-entity
# WANDB_API_KEY=your-wandb-api-key

# Redis設定（キャッシュ用、オプション）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0