# 開発環境設定
ENV=development
DEBUG=true

# データベース設定
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=congestion_watch
POSTGRES_USER=congestion_user
POSTGRES_PASSWORD=secure_password

# テスト用データベース
POSTGRES_TEST_DB=congestion_watch_test

# API設定
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# 機械学習設定
ML_MODEL_PATH=./models
ML_RETRAIN_INTERVAL=3600  # 1時間ごと
ML_PREDICTION_INTERVAL=300  # 5分ごと

# ログ設定
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Weights & Biases設定（オプション）
# WANDB_PROJECT=congestion-watch
# WANDB_ENTITY=your-wandb-entity
# WANDB_API_KEY=your-api-key

# Redis設定（キャッシュ用、オプション）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# 監視設定
MONITORING_ENABLED=true
METRICS_PORT=9090

