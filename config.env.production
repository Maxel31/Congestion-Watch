# 本番環境設定
ENV=production
DEBUG=false

# データベース設定
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=congestion_watch
POSTGRES_USER=congestion_user
POSTGRES_PASSWORD=secure_password_here

# API設定
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# 機械学習設定
ML_MODEL_PATH=/app/models
ML_RETRAIN_INTERVAL=3600  # 1時間ごと
ML_PREDICTION_INTERVAL=300  # 5分ごと

# ログ設定
LOG_LEVEL=INFO
LOG_FORMAT=json

# セキュリティ設定
SECRET_KEY=your-super-secret-key-here
ALLOWED_HOSTS=your-domain.com,api.your-domain.com

# Weights & Biases設定
WANDB_PROJECT=congestion-watch-prod
WANDB_ENTITY=your-wandb-entity
WANDB_API_KEY=your-production-api-key

# Redis設定
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis_password_here

# 監視設定
MONITORING_ENABLED=true
METRICS_PORT=9090

# ヘルスチェック設定
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# データベース接続プール設定
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30 